<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("./partials/head") %>
    <title>HomePage</title>
  </head>
  <body>
    <%- include("./partials/nav") %>

    <div class="container text-center mt-5">
      <h1>Welcome to Blogify</h1>
      <p class="lead">
        Your one-stop platform for sharing your thoughts and ideas.
      </p>
      <% if (!user) { %>
        <a href="/login" class="btn btn-primary mb-2">Sign In</a>
        <div>
          Dont have an account?
          <a
          href="/signup"
          class="mt-2 text-blue-500 hover:text-blue-700 font-semibold"
          >Sign Up</a
          >
        </div>
      <% } else { %>
        <h3>Welcome <%= user.name %></h3>

        <a href="/blog/add-new" class="btn btn-primary btn-sm m-2">
          Create Blog
        </a>
        <a href="/blog/update" class="btn btn-primary btn-sm m-2">
          Update Blog
        </a>
        <a href="/blog/delete" class="btn btn-primary btn-sm m-2">
          Delete Blog
        </a>

      <% } %>
    </div>

    <%- include("./partials/script") %>
  </body>
</html>
