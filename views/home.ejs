<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%- include("./partials/head") %>
    <title>HomePage</title>
  </head>
  <body>
    <%- include("./partials/nav") %>

    <div class="container text-center mt-5">
      <h1>Welcome to Blogify</h1>
      <p class="lead">
        Your one-stop platform for sharing your thoughts and ideas.
      </p>
      <% if (!user) { %>
        <a href="/user/login" class="btn btn-primary mb-2">Sign In</a>
        <div>
          Dont have an account?
          <a
          href="/user/signup"
          class="mt-2 text-blue-500 hover:text-blue-700 font-semibold"
          >Sign Up</a
          >
        </div>
      <% } else { %>
        <h3>Welcome <%= user.fullName %></h3>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mt-4">
          <% blogs.forEach(blog => { %>
            <div class="col">
              <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                <% if (blog.coverImageUrl) { %>
                  <img src="<%= blog.coverImageUrl %>" class="card-img-top" alt="<%= blog.title %>" style="height: 220px; object-fit: cover;">
                <% } %>
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title fw-bold"><%= blog.title %></h5>
                  <p class="card-text text-muted flex-grow-1">
                    <%= blog.body && blog.body.length > 120 ? blog.body.substring(0, 120) + '...' : blog.body %>
                  </p>
                  <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary btn-sm mt-auto">Read More</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

      <% } %>
    </div>

    <%- include("./partials/script") %>
  </body>
</html>
