<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog</title>
    <%- include("./partials/head") %>
  </head>
  <body>
    <%- include("./partials/nav") %>

    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <% if (blog.coverImageUrl) { %>
              <img src="<%= blog.coverImageUrl %>" class="card-img-top" alt="<%= blog.title %>" style="max-height: 420px; object-fit: cover;" />
            <% } %>
            <div class="card-body p-4 p-md-5">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <h2 class="card-title fw-bold mb-0"><%= blog.title %></h2>
                <div class="d-flex gap-2">
                  <a href="/blog/update/<%= blog._id %>" class="btn btn-outline-primary btn-sm">Update</a>
                  <a href="/blog/delete/<%= blog._id %>" class="btn btn-outline-danger btn-sm">Delete</a>
                </div>
              </div>
              <p class="card-text text-muted fs-5" style="line-height: 1.8;"><%= blog.body %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%- include("./partials/script") %>
  </body>
</html>
